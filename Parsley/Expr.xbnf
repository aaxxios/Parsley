// Arithmetic expressions with the usual precedence, lowest first:
//   + -        left associative
//   * / %      left associative
//   unary -    so -2 * 3 is (-2) * 3
//   ^          right associative, and tighter than unary minus: -2^2 is -(2^2), 2^3^2 is 2^(3^2)
// The left recursion in Expr and Term is rewritten as loops that fold left, so 10 - 4 - 3 parses as (10 - 4) - 3.
// The semantic actions after => evaluate the tree, so ExprEvaluator.Evaluate(ExprParser.Parse(tokens)) is the value.
@class "ExprParser";
@evaluator "ExprEvaluator";

// Expr is either Expr add Term (left, op, right) or a lone Term
Expr<start, type="double">= Term { add Term | sub Term } => {
    if (1 == node.Children.Count)
        return EvaluateTerm(node.Children[0]);
    var left = EvaluateExpr(node.Children[0]);
    var right = EvaluateTerm(node.Children[2]);
    return Add == node.Children[1].SymbolId ? left + right : left - right;
};
Term<type="double">= Term mul Unary | Term div Unary | Term mod Unary | Unary => {
    if (1 == node.Children.Count)
        return EvaluateUnary(node.Children[0]);
    var left = EvaluateTerm(node.Children[0]);
    var right = EvaluateUnary(node.Children[2]);
    switch (node.Children[1].SymbolId)
    {
        case Mul: return left * right;
        case Div: return left / right;
        default: return left % right;
    }
};
// the exponent is a Unary, so 2^-1 works and ^ groups to the right
Unary<type="double">= sub Unary | Power => {
    if (2 == node.Children.Count)
        return -EvaluateUnary(node.Children[1]);
    return EvaluatePower(node.Children[0]);
};
// Primary is collapsed, so the first child is either a number token or an Expr node
Power<type="double">= Primary [ pow Unary ] => {
    var first = node.Children[0];
    var value = Number == first.SymbolId
        ? double.Parse(first.Value!, System.Globalization.CultureInfo.InvariantCulture)
        : EvaluateExpr(first);
    if (1 == node.Children.Count)
        return value;
    return Math.Pow(value, EvaluateUnary(node.Children[2]));
};
// collapsed: a number or a parenthesized Expr sits directly in its parent
Primary<collapsed>= number | lparen Expr rparen;
number= '[0-9]+(\.[0-9]+)?';
add= "+";
sub= "-";
mul= "*";
div= "/";
mod= "%";
pow= "^";
lparen<collapsed>= "(";
rparen<collapsed>= ")";
whitespace<hidden>= '[ \t\r\n]+';
