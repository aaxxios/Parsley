// based on spec @ json.org
// Evaluates to plain CLR objects:
//   object  -> Dictionary<string, object?>   (duplicate keys throw FormatException)
//   array   -> List<object?>
//   number  -> double
//   string  -> string
//   true/false -> bool
//   null    -> null

Json<start, type="object">= Value => {
    return Evaluate(node.Children[0]);
};
Object<type="Dictionary<string, object?>">= "{" [ Field { "," Field } ] "}" => {
    return ProcessObject(node);
};
Field<type="KeyValuePair<string, object?>">= string ":" Value => {
    return ProcessField(node);
};
Array<type="List<object?>">= "[" [ Value { "," Value } ] "]" => {
    return ProcessArray(node);
};
Value<type="object?">= string |
	number	|
    Object	|
	Array	|
    Boolean |
    null	=> {
    return ProcessValue(node);
};
Boolean<type="bool">= true|false => {
    return node.Children[0].SymbolId == @true;
}; // boolean is non-terminal such that symbol ids can be checked for true and false rather than comparing strings while parsing
number= '\-?(0|[1-9][0-9]*)(\.[0-9]+)?([Ee][\+\-]?[0-9]+)?';
string= '"([^\n"\\]|\\([btrnf"\\/]|(u[0-9A-Fa-f]{4})))*"';
true= "true";
false= "false";
null= "null";
lbracket<collapsed>= "[";
rbracket<collapsed>= "]";
lbrace<collapsed>= "{";
rbrace<collapsed>= "}";
colon<collapsed>= ":";
comma<collapsed>= ",";
whitespace<hidden>= '[\n\r\t ]+';