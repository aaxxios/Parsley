<Project Sdk="Microsoft.NET.Sdk">
  <!-- BamcTest's grammars through the source generator instead of the command line tools: one [Parser] attribute
       synthesizes bamc's parser and lexer, and json-embed.xbnf's, which bamc embeds, nested in a class named Json -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Parsley.Generator\Parsley.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\Parsley.Generator\build\Parsley.Generator.targets" />

  <!-- the grammars are BamcTest's. bamc.xbnf's @external reads json.xbnf from beside it, so both are listed. -->
  <ItemGroup>
    <AdditionalFiles Include="..\BamcTest\json-embed.xbnf" />
    <AdditionalFiles Include="..\BamcTest\bamc.xbnf" />
    <None Include="..\BamcTest\*.bamc" CopyToOutputDirectory="PreserveNewest" LinkBase="examples" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\BamcTest\json-embed.xbnf" Link="json-embed.xbnf" />
  </ItemGroup>
</Project>
