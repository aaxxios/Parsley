// Approximate grammar for BrowserAutomationMaster .bamc scripts.
// Reverse-engineered from the examples, sections/documentation.md and
// Core/Parsing/Parser.cs; there's no official spec, so treat it as a sketch.
//
// Line-based: newlines separate lines (they don't terminate them), and a
// line's content is optional. So blank lines are fine and the last line
// doesn't need a trailing newline.

// add-headers takes a JSON object, which bamc's lexer can't lex (its strings
// differ, and braces nest). It's an island: json.xbnf lexes and parses it,
// and bamc sees one Headers token.
@external JsonEmbed "json-embed.xbnf";
@external JavascriptEmbed "javascript-embed.xbnf";
@namespace "BamcTest";
@using "System.Collections.Generic";
Script<type="List<BamcCommand>", start>= Line { newline Line } => {
    var result = new List<BamcCommand>(node.Children.Count);
    foreach(var child in node.Children) {
        result.Add((BamcCommand)Evaluate(child));
    }
    return result;
};
Line<collapsed>= [ Command ];

Command<collapsed, expected="a command">=
      Browser | Feature
    | Visit | OpenNewTab | CloseCurrentTab
    | Click | ClickExp | ClickAtPosition
    | FillText | FillTextExp | GetText
    | SelectElement | SelectOption
    | AddHeader | AddHeaders | AddCookie | SetCustomUserAgent
    | WaitForSeconds | TakeScreenshot | SaveAsHtml | SaveAsHtmlExp
    | Javascript;

// --- setup -----------------------------------------------------------------
// The real tool also enforces ordering (browser first, features before
// actions); that's left to a later pass rather than the grammar.

BrowserNames<collapsed>= Brave | Chrome | Chromium | Edge | Firefox | Opera | Safari;
Brave="\"brave\"";
Chrome="\"chrome\"";
Chromium="\"chromium\"";
Edge="\"edge\"";
Firefox="\"firefox\"";
Opera="\"opera\"";
Safari="\"safari\""; 

Browser= browserKeyword BrowserNames => {
    return new BamcBrowserCommand(node.Children[1].SymbolId-Brave,LineInfo.FromNode(node));
};   // browser "chrome"
Feature= featureKeyword Features [ string ] => {       // feature "use-http-proxy" "USER:PASS@IP:PORT"
    string? arg = null;
    if(node.Children.Count>2) {
        arg = UnquoteString(node.Children[2].Value!);
    }
    return new BamcFeatureCommand(node.Children[1].SymbolId-AddExtensionFeatureKeyword,arg,LineInfo.FromNode(node));
};
Features<collapsed>= [ 
  AddExtensionFeatureKeyword |
  AsyncFeatureKeyword |  
  BypassCloudflareFeatureKeyword | 
  DisablePycacheFeatureKeyword | 
  DisableSslFeatureKeyword |
  RunHeadlessFeatureKeyword |
  UseHttpProxyFeatureKeyword |
  UseHttpsProxyFeatureKeyword |
  UseSocks4ProxyFeatureKeyword |
  UseSocks5ProxyFeatureKeyword |
  UseMobileUserAgentFeatureKeyword
];

AddExtensionFeatureKeyword= "\"add-extension\"";
AsyncFeatureKeyword= "\"async\"";
BypassCloudflareFeatureKeyword= "\"bypass-cloudflare\"";
DisablePycacheFeatureKeyword= "\"disable-pycache\"";
DisableSslFeatureKeyword= "\"disable-ssl\"";
RunHeadlessFeatureKeyword= "\"run-headless\"";
UseHttpProxyFeatureKeyword= "\"use-http-proxy\"";
UseHttpsProxyFeatureKeyword= "\"use-https-proxy\"";
UseSocks4ProxyFeatureKeyword= "\"use-socks4-proxy\"";
UseSocks5ProxyFeatureKeyword= "\"use-socks5-proxy\"";
UseMobileUserAgentFeatureKeyword="\"use-mobile-user-agent\"";

// --- navigation ------------------------------------------------------------
Visit= visitKeyword string => {                      // visit "https://..."
    var url = node.Children[1].Value!;
    url = url.Substring(1,url.Length-2);
    return new BamcVisitCommand(new Uri(url),LineInfo.FromNode(node));
};
OpenNewTab= openNewTabKeyword string string => {
    return new BamcOpenNewTabCommand(new Uri( UnquoteString(node.Children[1].Value!)),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};     // open-new-tab "https://..." "3"
CloseCurrentTab= closeCurrentTabKeyword => {
    return new BamcCloseCurrentTabCommand(LineInfo.FromNode(node));
};

// --- element actions -------------------------------------------------------
Click= clickKeyword string => {
    return new BamcClickCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
ClickExp= clickExpKeyword string => {
    return new BamcClickExpCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
ClickAtPosition= clickAtPositionKeyword string string => {
    return new BamcClickAtPositionCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};   // "x" "y"
FillText= fillTextKeyword string string => {         // selector, value
    return new BamcFillTextCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};
FillTextExp= fillTextExpKeyword string string => {
    return new BamcFillTextExpCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};
GetText= getTextKeyword string => {
    return new BamcGetTextCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
SelectElement= selectElementKeyword string => {
    return new BamcSelectElementCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
SelectOption= selectOptionKeyword string number => {
    return new BamcSelectOptionCommand(UnquoteString(node.Children[1].Value!),int.Parse(node.Children[2].Value!,System.Globalization.CultureInfo.InvariantCulture),LineInfo.FromNode(node));
}; // selector, option index

// --- request setup ---------------------------------------------------------
AddHeader= addHeaderKeyword string string => {       // add-header "DNT" "1"
    return new BamcAddHeadersCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};
AddHeaders= addHeadersKeyword Headers => {
    var jsonNode = node.Children[1].Children[0];
    var json = JsonEmbed.Evaluator.Evaluate(jsonNode);
    return new BamcAddHeadersCommand((Dictionary<string,object?>)json,LineInfo.FromNode(node));
};  // add-headers {"a": "b", ...}

// The island starts right after add-headers and ends at the } that closes the
// object's first {. A line break inside it is an error to JSON's lexer, which
// also ends it, so a broken object can't swallow the lines after it.
Headers<entry="JsonEmbed.Object", after="addHeadersKeyword", nest="JsonEmbed.lbrace", pop="JsonEmbed.rbrace">;
AddCookie= addCookieKeyword string [ comma ] string => {  // one test uses a comma
    if(node.Children.Count==4) {
        return new BamcAddCookieCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[3].Value!),LineInfo.FromNode(node));
    }
    return new BamcAddCookieCommand(UnquoteString(node.Children[1].Value!),UnquoteString(node.Children[2].Value!),LineInfo.FromNode(node));
};
SetCustomUserAgent= setCustomUserAgentKeyword string => {
    return new BamcSetCustomUserAgentCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};

// --- output and timing -----------------------------------------------------
WaitForSeconds= waitForSecondsKeyword number => {    // 1, 1.5, .2
    return new BamcWaitForSecondsCommand(float.Parse(node.Children[1].Value!,System.Globalization.CultureInfo.InvariantCulture),LineInfo.FromNode(node));
};
TakeScreenshot= takeScreenshotKeyword string => {
    return new BamcTakeScreenshotCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
SaveAsHtml= saveAsHtmlKeyword string => {
    return new BamcSaveAsHtmlCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};
SaveAsHtmlExp= saveAsHtmlExpKeyword string => {
    return new BamcSaveAsHtmlExpCommand(UnquoteString(node.Children[1].Value!),LineInfo.FromNode(node));
};

// --- embedded JavaScript ---------------------------------------------------
// The whole start-javascript ... end-javascript block is one token, so the
// JS inside is never tokenized as bamc. The body is any lines that don't
// start with "end-javascript" (spelled out because DFA lexers usually have
// no lazy quantifiers or lookahead).
JavascriptBlock<entry="JavascriptEmbed.Body", after="jsStart">; 
Javascript= jsStart JavascriptBlock => {
    // easier maintenance than hardcoding numbers
    var endLen = "end-javascript".Length;
    var js = node.Children[1].Children[0].Children[0].Value!;
    js = js.Substring(0,js.Length-endLen).Trim();
    return new BamcJavaScriptCommand(js,LineInfo.FromNode(node));
};
// ===========================================================================
// Terminals. Keywords are declared before anything else so they win ties;
// longest match keeps "click" from eating the front of "click-exp".

jsStart= "start-javascript";
browserKeyword= "browser";
featureKeyword= "feature";
visitKeyword= "visit";
openNewTabKeyword= "open-new-tab";
closeCurrentTabKeyword= "close-current-tab";
clickKeyword= "click";
clickExpKeyword= "click-exp";
clickAtPositionKeyword= "click-at-position";
fillTextKeyword= "fill-text";
fillTextExpKeyword= "fill-text-exp";
getTextKeyword= "get-text";
selectElementKeyword= "select-element";
selectOptionKeyword= "select-option";
addHeaderKeyword= "add-header";
addHeadersKeyword= "add-headers";
addCookieKeyword= "add-cookie";
setCustomUserAgentKeyword= "set-custom-useragent";
waitForSecondsKeyword= "wait-for-seconds";
takeScreenshotKeyword= "take-screenshot";
saveAsHtmlKeyword= "save-as-html";
saveAsHtmlExpKeyword= "save-as-html-exp";

// Double- or single-quoted (the docs show click-exp 'selector').
string= '"([^"\\\n]|\\.)*"|\'([^\'\\\n]|\\.)*\'';
number= '[0-9]*\.?[0-9]+';
comma<collapsed>= ",";

newline<collapsed>= '\n';
comment<hidden>= '//[^\n]*';
whitespace<hidden>= '[ \t\r]+';



