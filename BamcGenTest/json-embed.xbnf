// based on spec @ json.org
// JsonTest's grammar, changed a little to serve as bamc's island grammar:
// Object is shared, so bamc can parse an island with it, and whitespace leaves
// out line breaks, so a JSON object in a .bamc script stays on its line (a
// line break is an error to this lexer, which ends the island). Its own
// namespace keeps its lexer's copy of the Luthor runtime apart from bamc's.
// based on spec @ json.org
// Evaluates to plain CLR objects:
//   object  -> Dictionary<string, object?>   (duplicate keys throw FormatException)
//   array   -> List<object?>
//   number  -> double
//   string  -> string
//   true/false -> bool
//   null    -> null
Json<start, type="object">= Value => {
    return Evaluate(node.Children[0]);
};
Object<shared,type="Dictionary<string, object?>">= "{" [ Field { "," Field } ] "}" => {
    // braces and commas are collapsed, so every child is a Field node
    var result = new Dictionary<string, object?>();
    foreach (var child in node.Children)
    {
        var field = EvaluateField(child);
        if (!result.TryAdd(field.Key, field.Value))
            throw new FormatException($"Duplicate key \"{field.Key}\" in object");
    }
    return result;
};
Field<type="KeyValuePair<string, object?>">= string ":" Value => {
    // the colon is collapsed: children are the string token and the Value node
    return new KeyValuePair<string, object?>(
        UnquoteString(node.Children[0].Value!),
        EvaluateValue(node.Children[1]));
};
Array<type="List<object?>">= "[" [ Value { "," Value } ] "]" => {
    // brackets and commas are collapsed, so every child is a Value node
    var result = new List<object?>(node.Children.Count);
    foreach (var child in node.Children)
        result.Add(EvaluateValue(child));
    return result;
};
Value<type="object?">= string |
	number	|
    Object	|
	Array	|
    Boolean |
    null	=> {
    var first = node.Children[0];
    switch (first.SymbolId)
    {
        case number:
            return double.Parse(first.Value!, System.Globalization.CultureInfo.InvariantCulture);
        case @string:
            return UnquoteString(first.Value!);
        case @null:
            return null;
        default:
            // an Object, Array or Boolean node
            return Evaluate(first);
    }
};
Boolean<type="bool">= true|false => {
    return node.Children[0].SymbolId == @true;
}; // boolean is non-terminal such that symbol ids can be checked for true and false rather than comparing strings while parsing
number= '\-?(0|[1-9][0-9]*)(\.[0-9]+)?([Ee][\+\-]?[0-9]+)?';
string= '"([^\n"\\]|\\([btrnf"\\/]|(u[0-9A-Fa-f]{4})))*"';
true= "true";
false= "false";
null= "null";
lbracket<collapsed>= "[";
rbracket<collapsed>= "]";
lbrace<collapsed>= "{";
rbrace<collapsed>= "}";
colon<collapsed>= ":";
comma<collapsed>= ",";
whitespace<hidden>= '[\t ]+';