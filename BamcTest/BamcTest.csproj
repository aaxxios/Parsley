<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BinDir Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)bin\</BinDir>
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildProjectDirectory)\..\bin\</BinDir>
    <SourceDir>$(MSBuildProjectDirectory)\</SourceDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="..\Parsley.Generator\build\Parsley.Generator.targets" />
  <!-- bamc.xbnf embeds json-embed.xbnf: add-headers takes a JSON object, an island that json.xbnf lexes and parses.
       Each grammar gets its parser and its lexer; bamc's parser lexes through a LexerController that switches between them. -->

  <!-- Step 1: grammars -> BamcParser.cs + Bamc.lex, JsonParser.cs + Json.lex -->
  <Target Name="GenerateBamcParser" BeforeTargets="BeforeBuild" Inputs="$(SourceDir)bamc.xbnf;$(SourceDir)json-embed.xbnf" Outputs="$(SourceDir)BamcParser.cs;$(SourceDir)Bamc.lex">
    <Exec Command="dotnet &quot;$(BinDir)parsley.dll&quot; &quot;$(SourceDir)bamc.xbnf&quot; -s -l &quot;$(SourceDir)Bamc.lex&quot; -o &quot;$(SourceDir)BamcParser.cs&quot;" />
  </Target>
  <Target Name="GenerateJsonParser" BeforeTargets="BeforeBuild" Inputs="$(SourceDir)json-embed.xbnf" Outputs="$(SourceDir)JsonEmbedParser.cs;$(SourceDir)Json.lex">
    <Exec Command="dotnet &quot;$(BinDir)parsley.dll&quot; &quot;$(SourceDir)json-embed.xbnf&quot; -l &quot;$(SourceDir)Json.lex&quot; -o &quot;$(SourceDir)JsonEmbedParser.cs&quot;" />
  </Target>

  <!-- Step 2: lexer files -> BamcLexer.cs, JsonLexer.cs. JsonLexer goes in json.xbnf's namespace, where bamc's parser looks for it. -->
  <Target Name="GenerateBamcLexer" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateBamcParser" Inputs="$(SourceDir)Bamc.lex" Outputs="$(SourceDir)BamcLexer.cs">
    <Exec Command="dotnet &quot;$(BinDir)parsley-luthor.dll&quot; &quot;$(SourceDir)Bamc.lex&quot; -c BamcLexer -o &quot;$(SourceDir)BamcLexer.cs&quot;" />
  </Target>
  <Target Name="GenerateJsonLexer" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateJsonParser" Inputs="$(SourceDir)Json.lex" Outputs="$(SourceDir)JsonEmbedLexer.cs">
    <Exec Command="dotnet &quot;$(BinDir)parsley-luthor.dll&quot; &quot;$(SourceDir)Json.lex&quot; -c JsonEmbedLexer -n BamcTest -o &quot;$(SourceDir)JsonEmbedLexer.cs&quot;" />
  </Target>
</Project>
