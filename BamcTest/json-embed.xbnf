// based on spec @ json.org
// JsonTest's grammar, changed a little to serve as bamc's island grammar:
// Object is shared, so bamc can parse an island with it, and whitespace leaves
// out line breaks, so a JSON object in a .bamc script stays on its line (a
// line break is an error to this lexer, which ends the island). Its own
// namespace keeps its lexer's copy of the Luthor runtime apart from bamc's.
@namespace "BamcTest.Json";
Json<start>= Object | Array;
Object<shared>= "{" [ Field { "," Field } ] "}";
Field= string ":" Value;
Array= "[" [ Value { "," Value } ] "]";
Value<collapsed>= string |
	number	|
    Object	|
	Array	|
    Boolean |
    null	;
Boolean= true|false; // boolean is non-terminal such that symbol ids can be checked for true and false rather than comparing strings while parsing
number= '\-?(0|[1-9][0-9]*)(\.[0-9]+)?([Ee][\+\-]?[0-9]+)?';
string= '"([^\n"\\]|\\([btrnf"\\/]|(u[0-9A-Fa-f]{4})))*"';
true= "true";
false= "false";
null= "null";
lbracket<collapsed>= "[";
rbracket<collapsed>= "]";
lbrace<collapsed>= "{";
rbrace<collapsed>= "}";
colon<collapsed>= ":";
comma<collapsed>= ",";
whitespace<hidden>= '[\r\t ]+';
