// Arithmetic expressions with the usual precedence, written as an operator rule.
// The alternatives of Expr are listed tightest first:
//   ^          right associative, and tighter than unary minus: -2^2 is -(2^2), 2^3^2 is 2^(3^2)
//   unary -    so -2 * 3 is (-2) * 3, and 2^-1 works because a prefix form can be any operand
//   * / %      left associative
//   + -        left associative, so 10 - 4 - 3 is (10 - 4) - 3
@class "ExprParser";
@evaluator "ExprEvaluator";
@using "System.Globalization";
@using "System.Collections.Generic";
// the operators by name, tightest first, then the atoms. Expr's own action only sees atoms,
// since every operator has its own production and action
Expr<start,state="Dictionary<string,double>", type="double", operators, expected="an expression">=
      Power
    | Negate
    | Product
    | Sum
    | identifier
    | number
    | lparen Expr rparen
    => {
    // an atom: a number token, or the Expr between the parentheses, which are collapsed
    var first = node.Children[0];
    switch(first.SymbolId) {
        case Number:
          return double.Parse(first.Value!, CultureInfo.InvariantCulture);
        case Identifier:
            return State[first.Value!];
        default:
            return EvaluateExpr(first);
    }
};
Power<type="double", assoc=right>= Expr pow Expr => {
    return Math.Pow(EvaluateExpr(node.Children[0]), EvaluateExpr(node.Children[2]));
};
Negate<type="double">= sub Expr => {
    return -EvaluateExpr(node.Children[1]);
};
Product<type="double">= Expr ( mul | div | mod ) Expr => {
    var left = EvaluateExpr(node.Children[0]);
    var right = EvaluateExpr(node.Children[2]);
    switch (node.Children[1].SymbolId)
    {
        case Mul: return left * right;
        case Div: return left / right;
        default: return left % right;
    }
};
Sum<type="double">= Expr ( add | sub ) Expr => {
    var left = EvaluateExpr(node.Children[0]);
    var right = EvaluateExpr(node.Children[2]);
    return Add == node.Children[1].SymbolId ? left + right : left - right;
};
identifier = '[A-Z_a-z][0-9A-Z_a-z]*';
number= '[0-9]+(\.[0-9]+)?';
add= "+";
sub= "-";
mul= "*";
div= "/";
mod= "%";
pow= "^";
lparen<collapsed>= "(";
rparen<collapsed>= ")";
whitespace<hidden>= '[ \t\r\n]+';