<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BinDir Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)bin\</BinDir>
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildProjectDirectory)\..\bin\</BinDir>
    <SourceDir>$(MSBuildProjectDirectory)\</SourceDir>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Step 1: grammar -> C99Parser.cs + json.lex -->
  <Target Name="GenerateC99Parser" BeforeTargets="BeforeBuild" Inputs="$(SourceDir)c99.xbnf" Outputs="$(SourceDir)C99Parser.cs;$(SourceDir)c99.lex">
    <Exec Command="dotnet &quot;$(BinDir)parsley.dll&quot; &quot;$(SourceDir)c99.xbnf&quot; -s -l &quot;$(SourceDir)c99.lex&quot; -o &quot;$(SourceDir)C99Parser.cs&quot;" />
  </Target>

  <!-- Step 2: json.lex -> C99Lexer.cs (runs after the parser has produced json.lex) -->
  <Target Name="GenerateC99Lexer" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateC99Parser" Inputs="$(SourceDir)c99.lex" Outputs="$(SourceDir)C99Lexer.cs">
    <Exec Command="dotnet &quot;$(BinDir)parsley-luthor.dll&quot; &quot;$(SourceDir)c99.lex&quot; -c C99Lexer -o &quot;$(SourceDir)C99Lexer.cs&quot;" />
  </Target>

  <!-- Step 3: always add the generated files to compilation 
  <Target Name="IncludeGeneratedC99Sources" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateC99Lexer">
    <ItemGroup>
      <Compile Include="$(SourceDir)C99Lexer.cs;$(SourceDir)C99Parser.cs" />
    </ItemGroup>
  </Target>
  -->
</Project>
